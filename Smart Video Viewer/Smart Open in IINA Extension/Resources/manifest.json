{
  "manifest_version": 3,
  "name": "Smart Open in IINA",
  "version": "2.0.6",
  "description": "网页独立观影、连续倍速、可设置秒数的快进快退，并保留 IINA 打开入口。",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "视频观影与 IINA",
    "default_icon": {
      "16": "toolbar-dark-16.png",
      "19": "toolbar-dark-19.png",
      "32": "toolbar-dark-32.png",
      "38": "toolbar-dark-38.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "subtitles.js",
        "viewer.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "x-video.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "toolbar-dark-38.png"
      ],
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://mobile.twitter.com/*"
      ]
    }
  ]
}
